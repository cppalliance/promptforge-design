# Rust build artifacts (regenerated by cargo build)
target/

# Generated datasets and extraction outputs (regenerable from the tools + sources)
dataset*.jsonl
first-gen-out/
first-gen-manifest.jsonl
sharpen-in/
sharpen-ref/
sharpen-out/
sharpen-tp-out/
tp-tutor.md
pairgen-out*
pairgen-in*
pairgen-run*

# Experiment battery: ignore regenerable/heavy outputs (API results, web dumps,
# blur intermediates), keep scripts (.py), the log, findings.md, and the final
# clean dataset tracked for reproducibility.
experiments/**/*.jsonl
!experiments/dataset-clean.jsonl
experiments/**/*.csv
experiments/**/*.log
experiments/**/*.plog
experiments/**/*.json
experiments/**/shard*.md

# Plain-english blur datasets: ignore intermediates, keep scripts, logs, and
# the final dataset-*.jsonl deliverables tracked.
plain-english/**/*.shard*
plain-english/**/*.plog
plain-english/**/*.run.log
plain-english/**/*.brun.log
plain-english/**/passages*.jsonl
plain-english/**/*.blur.jsonl
plain-english/**/blur-*.jsonl
plain-english/**/gate-*.jsonl
# Re-include the final dataset deliverables (the top-level dataset*.jsonl rule
# above otherwise catches these).
!plain-english/**/dataset-*.jsonl
